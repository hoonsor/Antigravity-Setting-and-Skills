{
  "plugins": {
    "android-cli-plugin": {
      "enabled": true
    },
    "chrome-devtools-plugin": {
      "enabled": true
    },
    "firebase": {
      "enabled": true
    },
    "flutter": {
      "enabled": true
    },
    "google-antigravity-sdk": {
      "enabled": true
    },
    "modern-web-guidance-plugin": {
      "enabled": true
    },
    "science": {
      "enabled": true
    }
  },
  "userSettings": {
    "customThemeSeedsDark": {
      "background": "#24273A",
      "foregroundOverride": "#CAD3F5",
      "primary": "#C6A0F6"
    },
    "globalPermissionGrants": {
      "allow": [
        "read_url(raw.githubusercontent.com)",
        "read_url(api.github.com)",
        "command(curl)",
        "command(firebase)",
        "command(git)",
        "command(node)",
        "command(npm)",
        "command(npx)",
        "command(pip)",
        "command(python)",
        "command(uv)",
        "command(vercel)",
        "command(yarn)",
        "command(docker)",
        "unsandboxed(curl)",
        "unsandboxed(firebase)",
        "unsandboxed(git)",
        "unsandboxed(node)",
        "unsandboxed(npm)",
        "unsandboxed(npx)",
        "unsandboxed(pip)",
        "unsandboxed(python)",
        "unsandboxed(uv)",
        "unsandboxed(vercel)",
        "unsandboxed(yarn)",
        "unsandboxed(docker)",
        "mcp(github-mcp-server/*)",
        "mcp(gdrive/*)",
        "read_url(aiprohub.vercel.app)",
        "read_url(tyai.tyc.edu.tw)",
        "mcp(notebooklm/notebook_list)",
        "mcp(notebooklm/notebook_create)",
        "mcp(notebooklm/source_add)",
        "mcp(notebooklm/source_delete)",
        "mcp(notebooklm/server_info)",
        "read_url(raphael-mindmap-data.vercel.app)",
        "read_url(laws.mol.gov.tw)",
        "read_url(edu.law.moe.gov.tw)",
        "mcp(notebooklm/source_list_drive)",
        "mcp(canva-mcp/*)"
      ]
    },
    "themeMode": "THEME_MODE_DARK",
    "useAiCredits": true,
    "remoteControlHostname": "desktop-b20cd0-polar-mars"
  }
}
